# Backend Dockerfile for AI Knowledge & Decision Assistant
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Copy the pre-built jar from target directory
COPY backend/target/knowledge-decision-assistant-1.0.0.jar app.jar

ENV SPRING_PROFILES_ACTIVE=mysql \
    DB_HOST=mysql \
    DB_PORT=3306 \
    DB_NAME=ai_assistant \
    DB_USER=root \
    DB_PASSWORD=rootpassword \
    LLM_PROVIDER=hybrid \
    JAVA_OPTS="-Djava.awt.headless=true -Xms256m -Xmx512m"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
